# Flask Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
# IMPORTANT: Generate with `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=change-this-secret-key-in-production-min-32-chars

# Server & Reverse Proxy Settings
HOST=0.0.0.0
PORT=5000
TRUSTED_PROXY_COUNT=0
MAX_CONTENT_LENGTH_BYTES=1048576

# Database Configuration & Connection Pool Security
# Default is SQLite in the instance folder.
# Production PostgreSQL example with SSL enforced:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname?sslmode=require
DATABASE_URL=sqlite:///app.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# JWT & Auth Security Configuration
# IMPORTANT: Must be distinct from SECRET_KEY and at least 32 characters in production
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Rate Limiting (Flask-Limiter)
# Use redis://localhost:6379/0 in production; memory:// for single-process dev
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per day;60 per minute
RATELIMIT_AUTH_LIMIT=5 per minute

# Caching (Flask-Caching)
# Use RedisCache with CACHE_REDIS_URL in production; SimpleCache for local dev
CACHE_TYPE=SimpleCache
CACHE_DEFAULT_TIMEOUT=60
CACHE_REDIS_URL=redis://localhost:6379/1

# Logging (text or json)
LOG_LEVEL=INFO
LOG_FORMAT=text

# CORS Configuration (comma-separated explicit origins; never use * in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# OpenAPI / Swagger UI Configuration (Disable in production if internal-only)
API_TITLE=FlaskFul API
API_VERSION=v1
OPENAPI_VERSION=3.0.3
OPENAPI_URL_PREFIX=/
OPENAPI_SWAGGER_UI_PATH=/docs
OPENAPI_REDOC_PATH=/redoc
